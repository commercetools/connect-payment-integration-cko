{
  "name": "payment-integration-checkout-com",
  "version": "1.0.0",
  "description": "Payment provider integration for checkout.com",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node_modules/.bin/nodemon -q dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix src",
    "build": "rm -rf /dist && tsc && tsc-alias",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "watch": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --detectOpenHandles --coverage",
    "test:watch": "jest --watch --detectOpenHandles",
    "connector:post-deploy": "node dist/connectors/post-deploy.js",
    "connector:pre-undeploy": "node dist/connectors/pre-undeploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@commercetools-backend/loggers": "24.13.0",
    "@commercetools/connect-payments-sdk": "0.27.1",
    "@fastify/autoload": "6.3.1",
    "@fastify/cors": "11.2.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/http-proxy": "11.4.1",
    "@fastify/request-context": "6.2.1",
    "@fastify/static": "8.3.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.45",
    "checkout-sdk-node": "3.0.3",
    "dotenv": "17.2.3",
    "fastify": "5.6.2",
    "fastify-plugin": "5.1.0",
    "jsonata": "2.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@jest/globals": "30.2.0",
    "@types/jest": "30.0.0",
    "@types/nock": "10.0.3",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.11.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unused-imports": "4.3.0",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "nock": "14.0.10",
    "node-fetch": "3.3.2",
    "nodemon": "3.1.11",
    "prettier": "3.7.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "path-to-regexp": "3.3.0"
  }
}