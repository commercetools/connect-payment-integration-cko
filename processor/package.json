{
  "name": "payment-integration-checkout-com",
  "version": "1.0.0",
  "description": "Payment provider integration for checkout.com",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node_modules/.bin/nodemon -q dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix src",
    "build": "rm -rf dist && tsc && tsc-alias",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "watch": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "connector:post-deploy": "node dist/connectors/post-deploy.js",
    "connector:pre-undeploy": "node dist/connectors/pre-undeploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@commercetools-backend/loggers": "27.16.0",
    "@commercetools/connect-payments-sdk": "1.6.1",
    "@fastify/autoload": "6.5.1",
    "@fastify/cors": "11.3.1",
    "@fastify/formbody": "9.0.1",
    "@fastify/http-proxy": "11.6.5",
    "@fastify/request-context": "7.0.5",
    "@fastify/static": "10.1.7",
    "@fastify/type-provider-typebox": "6.3.0",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "jsonata": "2.2.2"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "msw": "3.0.3",
    "node-fetch": "3.3.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.9",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "core-js-pure": false
  }
}
